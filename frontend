├── App.jsimport React, { useState } from "react";
import "./App.css";

const PRODUCTS = [
  {
    id: 1,
    name: "SKAHIDA V2 T-SHIRT",
    price: 100000,
    category: "LIMITED DROP",
    description:
      "Official SKAHIDA V2 limited drop. Premium everyday T-shirt dengan desain supporter-inspired.",
    image:
      "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=1000&q=80",
    sizes: ["S", "M", "L", "XL", "XXL"],
  },
];

function formatPrice(price) {
  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(price);
}

export default function App() {
  const [selectedProduct, setSelectedProduct] = useState(null);
  const [size, setSize] = useState("M");
  const [quantity, setQuantity] = useState(1);
  const [cart, setCart] = useState([]);
  const [checkoutOpen, setCheckoutOpen] = useState(false);
  const [menuOpen, setMenuOpen] = useState(false);
  const [orderComplete, setOrderComplete] = useState(false);

  const addToCart = () => {
    if (!selectedProduct) return;

    const newItem = {
      ...selectedProduct,
      size,
      quantity,
    };

    setCart((current) => [...current, newItem]);
    setSelectedProduct(null);
    setQuantity(1);
  };

  const removeFromCart = (index) => {
    setCart((current) => current.filter((_, i) => i !== index));
  };

  const cartTotal = cart.reduce(
    (total, item) => total + item.price * item.quantity,
    0
  );

  const cartItems = cart.reduce(
    (total, item) => total + item.quantity,
    0
  );

  const submitOrder = (event) => {
    event.preventDefault();

    setOrderComplete(true);
    setCart([]);
  };

  return (
    <div className="app">
      {/* NAVBAR */}
      <header className="navbar">
        <div className="nav-inner">
          <a href="#home" className="logo">
            SKAHIDA<span>.</span>
          </a>

          <nav className={menuOpen ? "nav-links open" : "nav-links"}>
            <a href="#home" onClick={() => setMenuOpen(false)}>
              HOME
            </a>
            <a href="#product" onClick={() => setMenuOpen(false)}>
              PRODUCT
            </a>
            <a href="#about" onClick={() => setMenuOpen(false)}>
              ABOUT
            </a>
          </nav>

          <button
            className="cart-button"
            onClick={() => setCheckoutOpen(true)}
          >
            CART <span>{cartItems}</span>
          </button>

          <button
            className="menu-button"
            onClick={() => setMenuOpen(!menuOpen)}
            aria-label="Menu"
          >
            ☰
          </button>
        </div>
      </header>

      {/* HERO */}
      <main>
        <section id="home" className="hero">
          <div className="hero-overlay" />

          <div className="hero-content">
            <p className="eyebrow">SKAHIDA 2012 PRESENTS</p>

            <h1>
              LIMITED
              <br />
              <span>DROP.</span>
            </h1>

            <p className="hero-description">
              Represent your colors. Wear the identity.
              <br />
              SKAHIDA V2 is here.
            </p>

            <a href="#product" className="primary-button">
              SHOP NOW <span>↗</span>
            </a>
          </div>

          <div className="hero-number">01</div>
        </section>

        {/* MARQUEE */}
        <div className="marquee">
          <div>
            SKAHIDA BOYS&nbsp;&nbsp; • &nbsp;&nbsp;LIMITED DROP&nbsp;&nbsp; •
            &nbsp;&nbsp;SKAHIDA BOYS&nbsp;&nbsp; • &nbsp;&nbsp;LIMITED DROP
            &nbsp;&nbsp; •
          </div>
        </div>

        {/* PRODUCT */}
        <section id="product" className="product-section">
          <div className="section-header">
            <div>
              <p className="section-label">01 / THE PRODUCT</p>
              <h2>SKAHIDA V2</h2>
            </div>

            <p className="section-note">
              Limited quantity.
              <br />
              Once it's gone, it's gone.
            </p>
          </div>

          <div className="product-card">
            <div className="product-image">
              <img
                src={PRODUCTS[0].image}
                alt={PRODUCTS[0].name}
              />

              <div className="image-badge">LIMITED</div>
            </div>

            <div className="product-info">
              <p className="product-category">
                {PRODUCTS[0].category}
              </p>

              <h3>{PRODUCTS[0].name}</h3>

              <div className="price">
                {formatPrice(PRODUCTS[0].price)}
              </div>

              <p className="product-description">
                {PRODUCTS[0].description}
              </p>

              <div className="feature-list">
                <div>
                  <span>01</span>
                  PREMIUM T-SHIRT
                </div>
                <div>
                  <span>02</span>
                  OFFICIAL SKAHIDA DESIGN
                </div>
                <div>
                  <span>03</span>
                  FREE 3-PACK STICKERS
                </div>
              </div>

              <button
                className="add-button"
                onClick={() => {
                  setSelectedProduct(PRODUCTS[0]);
                  setSize("M");
                  setQuantity(1);
                }}
              >
                SELECT SIZE <span>→</span>
              </button>
            </div>
          </div>
        </section>

        {/* ABOUT */}
        <section id="about" className="about-section">
          <div className="about-title">
            <p className="section-label">02 / THE IDENTITY</p>
            <h2>
              WEAR
              <br />
              YOUR
              <br />
              <span>IDENTITY.</span>
            </h2>
          </div>

          <div className="about-text">
            <p>
              SKAHIDA bukan sekadar sebuah nama. Ini adalah identitas,
              kebersamaan, dan cerita yang kita bawa bersama.
            </p>

            <p>
              Setiap detail pada SKAHIDA V2 dibuat untuk merepresentasikan
              semangat dan karakter kita.
            </p>

            <div className="about-line" />

            <p className="small-text">
              SKAHIDA 2012 — EST. 2012
            </p>
          </div>
        </section>

        {/* CTA */}
        <section className="cta-section">
          <p>READY?</p>
          <h2>
            MAKE IT
            <br />
            <span>YOURS.</span>
          </h2>

          <a href="#product" className="outline-button">
            GET THE DROP →
          </a>
        </section>
      </main>

      {/* FOOTER */}
      <footer>
        <div className="footer-logo">SKAHIDA.</div>

        <div className="footer-info">
          <span>SKAHIDA 2012</span>
          <span>LIMITED DROP</span>
          <span>© 2026</span>
        </div>
      </footer>

      {/* SIZE MODAL */}
      {selectedProduct && (
        <div className="modal-backdrop">
          <div className="modal">
            <button
              className="close-button"
              onClick={() => setSelectedProduct(null)}
            >
              ×
            </button>

            <p className="section-label">SELECT YOUR SIZE</p>

            <h3>{selectedProduct.name}</h3>

            <p className="modal-price">
              {formatPrice(selectedProduct.price)}
            </p>

            <div className="size-grid">
              {selectedProduct.sizes.map((item) => (
                <button
                  key={item}
                  className={size === item ? "size active" : "size"}
                  onClick={() => setSize(item)}
                >
                  {item}
                </button>
              ))}
            </div>

            <div className="quantity">
              <span>QUANTITY</span>

              <div className="quantity-control">
                <button
                  onClick={() =>
                    setQuantity(Math.max(1, quantity - 1))
                  }
                >
                  −
                </button>

                <strong>{quantity}</strong>

                <button
                  onClick={() => setQuantity(quantity + 1)}
                >
                  +
                </button>
              </div>
            </div>

            <button className="modal-add" onClick={addToCart}>
              ADD TO CART — {formatPrice(selectedProduct.price * quantity)}
            </button>
          </div>
        </div>
      )}

      {/* CART / CHECKOUT */}
      {checkoutOpen && (
        <div className="modal-backdrop">
          <div className="checkout-modal">
            <button
              className="close-button"
              onClick={() => {
                setCheckoutOpen(false);
                setOrderComplete(false);
              }}
            >
              ×
            </button>

            {!orderComplete ? (
              <>
                <p className="section-label">03 / CHECKOUT</p>
                <h3>YOUR ORDER</h3>

                {cart.length === 0 ? (
                  <div className="empty-cart">
                    <p>Your cart is empty.</p>
                    <button
                      className="modal-add"
                      onClick={() => setCheckoutOpen(false)}
                    >
                      CONTINUE SHOPPING
                    </button>
                  </div>
                ) : (
                  <>
                    <div className="cart-list">
                      {cart.map((item, index) => (
                        <div className="cart-item" key={index}>
                          <img src={item.image} alt={item.name} />

                          <div>
                            <strong>{item.name}</strong>
                            <p>
                              Size {item.size} × {item.quantity}
                            </p>
                            <span>
                              {formatPrice(
                                item.price * item.quantity
                              )}
                            </span>
                          </div>

                          <button
                            onClick={() => removeFromCart(index)}
                          >
                            ×
                          </button>
                        </div>
                      ))}
                    </div>

                    <div className="cart-total">
                      <span>TOTAL</span>
                      <strong>{formatPrice(cartTotal)}</strong>
                    </div>

                    <form
                      className="order-form"
                      onSubmit={submitOrder}
                    >
                      <input
                        required
                        placeholder="Nama lengkap"
                        type="text"
                      />

                      <input
                        required
                        placeholder="Nomor WhatsApp"
                        type="tel"
                      />

                      <textarea
                        required
                        placeholder="Alamat lengkap"
                        rows="4"
                      />

                      <button className="modal-add" type="submit">
                        PLACE PRE-ORDER →
                      </button>
                    </form>
                  </>
                )}
              </>
            ) : (
              <div className="success">
                <div className="success-icon">✓</div>

                <p className="section-label">
                  ORDER RECEIVED
                </p>

                <h3>THANK YOU.</h3>

                <p>
                  Pre-order kamu sudah tercatat.
                  <br />
                  Tim SKAHIDA akan menghubungi kamu
                  melalui WhatsApp.
                </p>

                <button
                  className="modal-add"
                  onClick={() => {
                    setCheckoutOpen(false);
                    setOrderComplete(false);
                  }}
                >
                  CLOSE
                </button>
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
}
